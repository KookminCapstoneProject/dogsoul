--- !u!114 &6605645259489899847
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8729130388294354405}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 36263ca77418d9148a3ed041780db20d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  backgorund: {fileID: 1466162755937054253}
  splashImage: {fileID: 6336460493111699703}
  texts:
  - {fileID: 4345569225149061318}
  - {fileID: 729013181566263544}
  - {fileID: 5482244452837058877}
  - {fileID: 6703916503117774073}
  - {fileID: 3381830323142998728}
  pages:
  - image: {fileID: 21300000, guid: 19d20160d29554440ab81d61de0ea224, type: 3}
    scripts:
    - "\uB2F9\uC2E0\uC740 \uAE4A\uC740 \uC7A0\uC5D0\uC11C \uAE68\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4."
    - "\uB530\uC2A4\uD55C \uD587\uBE5B\uC774 \uCC3D\uBB38 \uC0AC\uC774\uB85C \uC2A4\uBA70\uB4E4\uACE0,"
    - "\uC0C8\uB4E4\uC758 \uC9C0\uC800\uADD0\uC774 \uB4E4\uB824\uC635\uB2C8\uB2E4."
    - 
    - "\uBAA8\uB4E0 \uAC83\uC774... \uD3C9\uD654\uB85C\uC6B4 \uC544\uCE68\uC785\uB2C8\uB2E4."
  - image: {fileID: 21300000, guid: 1d852b303accd1244be5fb0d9498e692, type: 3}
    scripts:
    - "\uC624\uB298\uB530\uB77C \uC720\uB09C\uD788 \uBAB8\uC774 \uAC00\uBCCD\uC2B5\uB2C8\uB2E4."
    - "\uAE30\uC9C0\uAC1C\uB97C \uCF1C\uB824\uB358 \uC21C\uAC04,"
    - "\uD314\uC774... \uC544\uB2C8, \uC55E\uBC1C\uC774 \uB208\uC55E\uC5D0 \uBCF4\uC785\uB2C8\uB2E4."
  - image: {fileID: 21300000, guid: 2a2da7b4c3b89b04eb5470d43668be2d, type: 3}
    scripts:
    - "\uB2F9\uC2E0\uC740 \uD669\uAE09\uD788 \uAC70\uC6B8 \uC55E\uC73C\uB85C \uB2EC\uB824\uAC11\uB2C8\uB2E4."
    - "\uAC70\uC6B8 \uC18D\uC5D0\uB294..."
    - "\uADC0\uAC00 \uCD95 \uB298\uC5B4\uC9C4, \uD138\uBCF5\uC22D\uC774 \uAC1C \uD55C
      \uB9C8\uB9AC\uAC00 \uC11C \uC788\uC2B5\uB2C8\uB2E4."
    - 
    - "\"\uC774\uAC8C... \uB098\uB77C\uACE0?\""
  - image: {fileID: 21300000, guid: 22fb2eddaf1a51043b2c9e46d3d13100, type: 3}
    scripts:
    - "\uADF8 \uC21C\uAC04, \uC78A\uACE0 \uC788\uB358 \uAE30\uC5B5\uC774 \uC2A4\uCE58\uB4EF
      \uB5A0\uC624\uB985\uB2C8\uB2E4."
    - "\uAC80\uC740 \uB85C\uBE0C\uB97C \uC785\uC740 \uB9C8\uB140."
    - "\uB9C8\uB140\uB294 \uC0AC\uC545\uD55C \uBBF8\uC18C\uB97C \uC9C0\uC73C\uBA70
      \uB9D0\uD588\uC2B5\uB2C8\uB2E4."
    - 
    - "\"\uC601\uC6C5\uB180\uC774\uB294 \uC774\uC81C \uB05D\uB0AC\uC5B4!\""
  - image: {fileID: 21300000, guid: 22fb2eddaf1a51043b2c9e46d3d13100, type: 3}
    scripts:
    - "\uCC30\uB098\uC758 \uD3C9\uD654\uB294 \uBB3C\uAC70\uD488\uC774 \uB418\uC5C8\uACE0,"
    - "\uB2F9\uC2E0\uC758 \uB9C8\uC74C\uC5D0\uB294 \uBD84\uB178\uAC00 \uC0D8\uC19F\uC2B5\uB2C8\uB2E4."
    - "\uAC1C\uAC00 \uB41C \uBAB8\uC774\uC9C0\uB9CC, \uB9C8\uC74C\uB9CC\uC740 \uC5EC\uC804\uD788
      \uC6A9\uC0AC."
    - "\uC774 \uC800\uC8FC\uB97C \uB05D\uB0B4\uAE30 \uC704\uD574\u2014"
    - "\uB2F9\uC2E0\uC740 \uC800\uC8FC\uBC1B\uC740 \uC131\uCC44\uB85C \uD5A5\uD569\uB2C8\uB2E4."
